// Datos de ejemplo de la validación del modelo (20 nodos y 28 relaciones).
// Cargar SOLO en un Neo4j de pruebas, después de restricciones.cypher.
// Incluye: dos personas mayores con datos propios, un recuerdo sin año, una persona mencionada solo por
// su vínculo, una pregunta del guion sin franja de edad, un progreso con preguntas respondidas, salteada
// y pendiente, y dos personas distintas llamadas "Marta" (una por cada persona mayor).
CREATE
 (pm1:PersonaMayor {idPersonaMayor: 1}),
 (pm2:PersonaMayor {idPersonaMayor: 2}),
 (q1:PreguntaGuion {idPreguntaGuion: 1, orden: 1, texto: '¿Cómo te gusta que te llamen?'}),
 (q2:PreguntaGuion {idPreguntaGuion: 2, orden: 2, texto: '¿Dónde naciste y cómo era la casa de tu infancia?', edadDesde: 0, edadHasta: 11}),
 (q3:PreguntaGuion {idPreguntaGuion: 3, orden: 3, texto: '¿Cómo eran tus años de escuela?', edadDesde: 6, edadHasta: 12}),
 (q4:PreguntaGuion {idPreguntaGuion: 4, orden: 4, texto: '¿Cuál fue tu primer trabajo?', edadDesde: 18, edadHasta: 25}),
 (q5:PreguntaGuion {idPreguntaGuion: 5, orden: 5, texto: '¿Cómo conociste a tu pareja?', edadDesde: 18, edadHasta: 35}),
 (pm1)-[:RESPONDIO {fecha: datetime('2026-09-01T10:00:00')}]->(q1),
 (pm1)-[:RESPONDIO {fecha: datetime('2026-09-01T10:05:00')}]->(q2),
 (pm1)-[:RESPONDIO {fecha: datetime('2026-09-02T11:00:00')}]->(q3),
 (pm1)-[:SALTEO {fecha: datetime('2026-09-02T11:10:00')}]->(q4),
 (pm2)-[:RESPONDIO {fecha: datetime('2026-09-03T09:00:00')}]->(q1),
 (marta:Persona {idPersona: 1, nombre: 'Marta', nombreNormalizado: 'marta'}),
 (rosa:Persona {idPersona: 2, nombre: 'Rosa', nombreNormalizado: 'rosa'}),
 (elena:Persona {idPersona: 3, nombre: 'Elena', nombreNormalizado: 'elena'}),
 (tio:Persona {idPersona: 4}),
 (pm1)-[:CONOCE {vinculo: 'hermana'}]->(marta),
 (pm1)-[:CONOCE {vinculo: 'madre'}]->(rosa),
 (pm1)-[:CONOCE {vinculo: 'maestra'}]->(elena),
 (pm1)-[:CONOCE {vinculo: 'tío'}]->(tio),
 (cip:Lugar {idLugar: 1, nombre: 'Cipolletti', nombreNormalizado: 'cipolletti'}),
 (escuela:Lugar {idLugar: 2, nombre: 'Escuela N° 12', nombreNormalizado: 'escuela n° 12'}),
 (rio:Lugar {idLugar: 3, nombre: 'Río Negro', nombreNormalizado: 'rio negro'}),
 (r1:Recuerdo {idRecuerdo: 1, titulo: 'La casa de la calle San Martín',
   descripcion: 'Una casa chica con patio, donde vivía con su madre y su hermana.',
   anio: 1958, precision: 'APROXIMADA', etapaDeVida: 'INFANCIA',
   fechaRegistro: datetime('2026-09-01T10:06:00')}),
 (r2:Recuerdo {idRecuerdo: 2, titulo: 'Mi maestra Elena',
   descripcion: 'Su maestra de primer grado, que le enseñó a leer.',
   anio: 1957, precision: 'EXACTA', etapaDeVida: 'INFANCIA',
   fechaRegistro: datetime('2026-09-02T11:02:00')}),
 (r3:Recuerdo {idRecuerdo: 3, titulo: 'Veranos en el río',
   descripcion: 'Los veranos en el río con su hermana y un tío.',
   fechaRegistro: datetime('2026-09-01T10:08:00')}),
 (pm1)-[:TIENE_RECUERDO]->(r1), (pm1)-[:TIENE_RECUERDO]->(r2), (pm1)-[:TIENE_RECUERDO]->(r3),
 (r1)-[:SURGIO_DE]->(q2), (r2)-[:SURGIO_DE]->(q3), (r3)-[:SURGIO_DE]->(q2),
 (marta)-[:PARTICIPA_EN]->(r1), (rosa)-[:PARTICIPA_EN]->(r1),
 (elena)-[:PARTICIPA_EN]->(r2),
 (marta)-[:PARTICIPA_EN]->(r3), (tio)-[:PARTICIPA_EN]->(r3),
 (r1)-[:OCURRIO_EN]->(cip), (r2)-[:OCURRIO_EN]->(escuela), (r3)-[:OCURRIO_EN]->(rio),
 (marta2:Persona {idPersona: 5, nombre: 'Marta', nombreNormalizado: 'marta'}),
 (cip2:Lugar {idLugar: 4, nombre: 'Cipolletti', nombreNormalizado: 'cipolletti'}),
 (r4:Recuerdo {idRecuerdo: 4, titulo: 'Mi bautismo',
   descripcion: 'El día de su bautismo, con su amiga Marta.',
   anio: 1975, precision: 'EXACTA', etapaDeVida: 'JUVENTUD',
   fechaRegistro: datetime('2026-09-03T09:05:00')}),
 (pm2)-[:CONOCE {vinculo: 'amiga'}]->(marta2),
 (pm2)-[:TIENE_RECUERDO]->(r4), (r4)-[:SURGIO_DE]->(q1),
 (marta2)-[:PARTICIPA_EN]->(r4), (r4)-[:OCURRIO_EN]->(cip2);
