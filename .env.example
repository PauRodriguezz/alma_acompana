# PostgreSQL
POSTGRES_DB=alma
POSTGRES_USER=alma
POSTGRES_PASSWORD=cambiar_esta_clave

# Neo4j (la clave debe tener al menos 8 caracteres)
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_esta_clave

# SPRING_PROFILES_ACTIVE=prod  <- solo en un despliegue real: apaga Swagger. En desarrollo no se define.

# Proveedor de IA del chat: gemini | ollama
IA_PROVEEDOR=gemini

# Gemini (crear la clave en https://aistudio.google.com/apikey)
# La clave se escribe solo en tu .env local (no se sube a Git). Docker Compose se la pasa al contenedor del back.
# ATENCIÓN: el nivel gratuito de Gemini NO debe usarse con datos reales de personas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (solo si IA_PROVEEDOR=ollama)
OLLAMA_MODEL=gemma4:cloud
# Se completa si la prueba del paso 4 lo requiere
OLLAMA_API_KEY=

# JWT (texto largo y aleatorio, mínimo 32 caracteres Generar con: openssl rand -base64 48)
JWT_SECRET=generar_un_valor_aleatorio
# Duración del token de sesión normal, en minutos (por defecto 1440 = 1 día)
# JWT_EXPIRATION_MINUTES=1440
# Duración del token con "Mantener sesión iniciada" (por defecto 43200 = 30 días)
# JWT_REMEMBER_EXPIRATION_MINUTES=43200

# Usuarios de demo (ana, carlos, admin) y datos de ejemplo. Por defecto APAGADO.
# Para tener las cuentas de demo, poné true. En un despliegue real dejalo en false:
# las cuentas de demo tienen una contraseña conocida.
# ALMA_SEED_ENABLED=true

# Carpeta de imágenes subidas desde el panel (por defecto ./uploads, relativa a donde corre el back)
# ALMA_UPLOADS_DIR=./uploads

# Puerto donde se publica la app con "docker compose up --build" (por defecto 8081)
# FRONTEND_PORT=8081
