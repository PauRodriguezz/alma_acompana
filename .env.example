# PostgreSQL
POSTGRES_DB=alma
POSTGRES_USER=alma
POSTGRES_PASSWORD=cambiar_esta_clave

# Neo4j (la clave debe tener al menos 8 caracteres)
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_esta_clave

# Perfil del chat: cloud (Ollama Cloud) o local (modelo en el equipo)
SPRING_PROFILES_ACTIVE=cloud

# Proveedor de IA del chat: gemini | ollama
IA_PROVEEDOR=gemini

# Gemini (crear la clave en https://aistudio.google.com/apikey)
# ATENCIÓN: el nivel gratuito de Gemini NO debe usarse con datos reales de personas (ver docs/contrato-ia.md, sección 5).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (solo si IA_PROVEEDOR=ollama)
OLLAMA_MODEL=gemma4:cloud
# Se completa si la prueba del paso 4 lo requiere
OLLAMA_API_KEY=

# JWT (texto largo y aleatorio, mínimo 32 caracteres Generar con: openssl rand -base64 48)
JWT_SECRET=generar_un_valor_aleatorio
# Duración del token con "Mantener sesión iniciada" (por defecto 43200 = 30 días)
# JWT_REMEMBER_EXPIRATION_MINUTES=43200

# Usuarios de prueba (poner false en despliegues reales)
# ALMA_SEED_ENABLED=true

# Carpeta de imágenes subidas desde el panel (por defecto ./uploads, relativa a donde corre el back)
# ALMA_UPLOADS_DIR=./uploads
